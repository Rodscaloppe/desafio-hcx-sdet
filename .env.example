# ---------------------------------------------------------------------------
# Configuração do ambiente de teste - copie para .env e ajuste.
# NUNCA versionar o arquivo .env (já está no .gitignore).
# ---------------------------------------------------------------------------

# URL base do sistema sob teste (Automation Exercise)
BASE_URL=https://automationexercise.com

# URL base da API do Automation Exercise (normalmente <BASE_URL>/api)
AE_API_URL=https://automationexercise.com/api

# Credenciais de usuário já existente (OPCIONAL).
# Se ausentes, a suíte provisiona um usuário único via API e remove no teardown.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Estratégia de provisionamento de usuários nos testes web:
#   auto (padrão) = tenta a API; cai para cadastro pela UI se houver
#                   bloqueio anti-bot (datacenter)
#   api           = somente API
#   ui            = somente cadastro pela UI
PROVISIONING_STRATEGY=auto

# Timeouts em milissegundos
DEFAULT_TIMEOUT=10000
PAGE_LOAD_TIMEOUT=60000
API_TIMEOUT=15000

# --- Integração Trello (API-01) -------------------------------------------
# Endpoint configurável da API Trello e identificador da lista sob teste.
TRELLO_API_BASE=https://api.trello.com/1
TRELLO_LIST_ID=

# Credenciais Trello (OPCIONAIS). Sem elas, apenas os cenários de contrato
# de erro (401) são executados; os cenários autenticados (@trello-auth)
# exigem TRELLO_API_KEY e TRELLO_API_TOKEN válidos.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
